/*******************************************************************************************
  模块名称: PWR_DIGBIRD_m18
  功能说明: DIGBIRD m18智能电源控制器控制模块
  通讯协议: RS485/UDP（UDP端口8234）
  串口参数: 波特率115200, 1停止位, 无奇偶校验
  RS485接线:
    ① 白-橙：485-B
    ② 橙  ：485-A
    ⑥ 绿  ：GND
  命令格式: FE 00 00 FF FF 00 00 0E F1 1X 00 00 00 00 00 XX
    1X = 操作码: 10=全开, 14=全关
    XX = 校验和
  支持功能: 电源全开、电源全关
*******************************************************************************************/

#SYMBOL_NAME "PWR_DIGBIRD_m18"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  输入输出定义
*******************************************************************************************/
DIGITAL_INPUT power_allon, power_alloff;
DIGITAL_OUTPUT power_allon_fb, power_alloff_fb;
BUFFER_INPUT power_rx[100];
STRING_OUTPUT power_tx;

/*******************************************************************************************
  辅助函数：发送电源全开命令
  命令格式: FE 00 00 FF FF 00 00 0E F1 10 00 00 00 00 00 1D
  说明: 连续发送2次以提高可靠性
*******************************************************************************************/
Function PowerAllOn()
{
    power_tx = chr(0xFE) + chr(0x00) + chr(0x00) + chr(0xFF) + chr(0xFF) + chr(0x00) + chr(0x00) + chr(0x0E) + chr(0xF1) + chr(0x10) + chr(0x00) + chr(0x00) + chr(0x00) + chr(0x00) + chr(0x00) + chr(0x1D);
    power_tx = chr(0xFE) + chr(0x00) + chr(0x00) + chr(0xFF) + chr(0xFF) + chr(0x00) + chr(0x00) + chr(0x0E) + chr(0xF1) + chr(0x10) + chr(0x00) + chr(0x00) + chr(0x00) + chr(0x00) + chr(0x00) + chr(0x1D);
}

/*******************************************************************************************
  辅助函数：发送电源全关命令
  命令格式: FE 00 00 FF FF 00 00 0E F1 14 00 00 00 00 00 C1
  说明: 连续发送2次以提高可靠性
*******************************************************************************************/
Function PowerAllOff()
{
    power_tx = chr(0xFE) + chr(0x00) + chr(0x00) + chr(0xFF) + chr(0xFF) + chr(0x00) + chr(0x00) + chr(0x0E) + chr(0xF1) + chr(0x14) + chr(0x00) + chr(0x00) + chr(0x00) + chr(0x00) + chr(0x00) + chr(0xC1);
    power_tx = chr(0xFE) + chr(0x00) + chr(0x00) + chr(0xFF) + chr(0xFF) + chr(0x00) + chr(0x00) + chr(0x0E) + chr(0xF1) + chr(0x14) + chr(0x00) + chr(0x00) + chr(0x00) + chr(0x00) + chr(0x00) + chr(0xC1);
}

/*******************************************************************************************
  事件：电源全开
  说明: 按下power_allon后，更新反馈状态并延时1秒发送开机命令
        延时发送是为了避免按钮抖动导致的误操作
*******************************************************************************************/
PUSH power_allon
{
    power_allon_fb = 1;
    power_alloff_fb = 0;
    CancelAllWait();
    WAIT(100)
    {
        PowerAllOn();
    }
}

/*******************************************************************************************
  事件：电源全关
  说明: 按下power_alloff后，更新反馈状态并延时1秒发送关机命令
        延时发送是为了避免按钮抖动导致的误操作
*******************************************************************************************/
PUSH power_alloff
{
    power_allon_fb = 0;
    power_alloff_fb = 1;
    CancelAllWait();
    WAIT(100)
    {
        PowerAllOff();
    }
}