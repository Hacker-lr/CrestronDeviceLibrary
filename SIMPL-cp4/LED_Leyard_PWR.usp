/*******************************************************************************************
  模块名称: LED_Leyard_PWR
  功能说明: 利亚德(Leyard)LED屏电源控制模块
  通讯协议: Modbus RTU over RS485
  串口参数: 波特率9600, 1停止位, 无奇偶校验（默认）
  命令格式: :AA FC RR RR NN NN DD DD CC\r\n
    AA = 从站地址（00）
    FC = 功能码（10=写多个寄存器）
    RR RR = 起始寄存器地址（00B0 = 176）
    NN NN = 寄存器数量（0001）
    DD DD = 控制数据（0001=开, 0002=关）
    CC = CRC校验码
  支持功能: LED屏电源开启、关闭
*******************************************************************************************/

#SYMBOL_NAME "LED_Leyard_PWR"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  输入输出定义
*******************************************************************************************/
DIGITAL_INPUT led_open, led_close;
DIGITAL_OUTPUT led_open_fb, led_close_fb;
BUFFER_INPUT led_rx[100];
STRING_OUTPUT led_tx;

/*******************************************************************************************
  全局变量：预定义命令字符串
  在Main()中初始化，避免重复构建字符串
*******************************************************************************************/
STRING cmd_open[30], cmd_close[30];

/*******************************************************************************************
  辅助函数：发送LED开机命令
  命令: :001000B0000100013E\r\n
  解析: 地址00 + 功能码10 + 寄存器00B0 + 数量0001 + 数据0001 + CRC3E
*******************************************************************************************/
Function LedPowerOn()
{
    led_tx = cmd_open;
}

/*******************************************************************************************
  辅助函数：发送LED关机命令
  命令: :001000B0000100023D\r\n
  解析: 地址00 + 功能码10 + 寄存器00B0 + 数量0001 + 数据0002 + CRC3D
*******************************************************************************************/
Function LedPowerOff()
{
    led_tx = cmd_close;
}

/*******************************************************************************************
  事件：LED电源开启
  说明: 按下led_open后，更新反馈状态并发送开机命令
        CancelAllWait()确保取消之前的等待操作，避免冲突
*******************************************************************************************/
PUSH led_open
{
    led_open_fb = 1;
    led_close_fb = 0;
    CancelAllWait();
    LedPowerOn();
}

/*******************************************************************************************
  事件：LED电源关闭
  说明: 按下led_close后，更新反馈状态并发送关机命令
        CancelAllWait()确保取消之前的等待操作，避免冲突
*******************************************************************************************/
PUSH led_close
{
    led_open_fb = 0;
    led_close_fb = 1;
    CancelAllWait();
    LedPowerOff();
}

/*******************************************************************************************
  Main函数：系统启动时执行一次
  说明: 初始化命令字符串，避免每次发送时重新构建
        命令转换为ASCII字符：
        - 开: :001000B0000100013E\r\n = 0x3A 0x30 0x30 ... 0x33 0x45 0x0D 0x0A
        - 关: :001000B0000100023D\r\n = 0x3A 0x30 0x30 ... 0x33 0x44 0x0D 0x0A
*******************************************************************************************/
Function Main()
{
    cmd_open = chr(0x3A) + chr(0x30) + chr(0x30) + chr(0x31) + chr(0x30) + chr(0x30) + chr(0x30) + chr(0x42) + chr(0x30) + chr(0x30) + chr(0x30) + chr(0x30) + chr(0x31) + chr(0x30) + chr(0x30) + chr(0x30) + chr(0x31) + chr(0x33) + chr(0x45) + chr(0x0D) + chr(0x0A);
    cmd_close = chr(0x3A) + chr(0x30) + chr(0x30) + chr(0x31) + chr(0x30) + chr(0x30) + chr(0x30) + chr(0x42) + chr(0x30) + chr(0x30) + chr(0x30) + chr(0x30) + chr(0x31) + chr(0x30) + chr(0x30) + chr(0x30) + chr(0x32) + chr(0x33) + chr(0x44) + chr(0x0D) + chr(0x0A);
}