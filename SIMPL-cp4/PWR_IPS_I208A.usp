/*******************************************************************************************
  模块名称: PWR_IPS_I208A
  功能说明: IPS I208A串口电源控制器控制模块
  通讯协议: RS232
  串口参数: 波特率115200, 1停止位, 无奇偶校验
  命令格式: AA 00 XX 08 00 55
    AA = 帧头
    00 = 固定字节
    XX = 控制码（00=全开, 01=全关）
    08 = 固定字节
    00 = 固定字节
    55 = 帧尾
  支持功能: 电源全开、电源全关
*******************************************************************************************/

#SYMBOL_NAME "PWR_IPS_I208A"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  输入输出定义
*******************************************************************************************/
DIGITAL_INPUT power_allon, power_alloff;
DIGITAL_OUTPUT power_allon_fb, power_alloff_fb;
BUFFER_INPUT power_rx[100];
STRING_OUTPUT power_tx;

/*******************************************************************************************
  辅助函数：发送电源全开命令
  命令: AA 00 00 08 00 55
  说明: 连续发送2次以提高可靠性
*******************************************************************************************/
Function PowerAllOn()
{
    power_tx = chr(0xAA) + chr(0x00) + chr(0x00) + chr(0x08) + chr(0x00) + chr(0x55);
    power_tx = chr(0xAA) + chr(0x00) + chr(0x00) + chr(0x08) + chr(0x00) + chr(0x55);
}

/*******************************************************************************************
  辅助函数：发送电源全关命令
  命令: AA 00 01 08 00 55
  说明: 连续发送2次以提高可靠性
*******************************************************************************************/
Function PowerAllOff()
{
    power_tx = chr(0xAA) + chr(0x00) + chr(0x01) + chr(0x08) + chr(0x00) + chr(0x55);
    power_tx = chr(0xAA) + chr(0x00) + chr(0x01) + chr(0x08) + chr(0x00) + chr(0x55);
}

/*******************************************************************************************
  事件：电源全开
  说明: 按下power_allon后，更新反馈状态并延时200ms发送开机命令
        延时发送是为了避免按钮抖动导致的误操作
*******************************************************************************************/
PUSH power_allon
{
    power_allon_fb = 1;
    power_alloff_fb = 0;
    CancelAllWait();
    WAIT(20)
    {
        PowerAllOn();
    }
}

/*******************************************************************************************
  事件：电源全关
  说明: 按下power_alloff后，更新反馈状态并延时200ms发送关机命令
        延时发送是为了避免按钮抖动导致的误操作
*******************************************************************************************/
PUSH power_alloff
{
    power_allon_fb = 0;
    power_alloff_fb = 1;
    CancelAllWait();
    WAIT(20)
    {
        PowerAllOff();
    }
}