/*******************************************************************************************
  模块名称 : PWR_LOHTEA_IP_SPS08C_v1.02d
  功能说明 : LOHTEA SPS08C v1.02d 网络电源控制器 IP 驱动模块
  优化记录 : 精简模板代码；提取公共函数；移除重复发送；添加中文注释
*******************************************************************************************/
#SYMBOL_NAME "PWR_LOHTEA_IP_SPS08C_v1.02d"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  输入输出定义（保留原始顺序以兼容 .ush）
*******************************************************************************************/
DIGITAL_INPUT power_allon,power_alloff;
//DIGITAL_INPUT power_on[8],power_off[8];

DIGITAL_OUTPUT power_allon_fb,power_alloff_fb;
//DIGITAL_OUTPUT power_on_fb[8],power_off_fb[8];

//ANALOG_INPUT 
//STRING_INPUT 
BUFFER_INPUT  power_rx[100];

//DIGITAL_OUTPUT 
//ANALOG_OUTPUT 
STRING_OUTPUT power_tx;

/*******************************************************************************************
  全局变量
*******************************************************************************************/
STRING cmd_allon[6];
STRING cmd_alloff[6];

/*******************************************************************************************
  辅助函数
*******************************************************************************************/
// 设置电源总开关反馈状态（互锁）
Function SetPowerFb(INTEGER state)
{
	power_allon_fb  = state;
	power_alloff_fb = 1 - state;
}

// 发送串口命令到电源设备
Function SendCmd(STRING cmd)
{
	power_tx = cmd;
}

/*******************************************************************************************
  事件处理
*******************************************************************************************/
PUSH power_allon
{
	SetPowerFb(1);
	CancelAllWait();
	wait(100)
	{
		SendCmd(cmd_allon);
	}
}

PUSH power_alloff
{
	SetPowerFb(0);
	CancelAllWait();
	wait(100)
	{
		SendCmd(cmd_alloff);
	}
}

/*******************************************************************************************
  主函数：上电初始化
*******************************************************************************************/
Function Main()
{
	// 全开命令: 55 01 00 0D F0 AA
	cmd_allon  = chr(0x55) + chr(0x01) + chr(0x00) + chr(0x0D) + chr(0xF0) + chr(0xAA);
	// 全关命令: 55 01 00 0D F1 AA
	cmd_alloff = chr(0x55) + chr(0x01) + chr(0x00) + chr(0x0D) + chr(0xF1) + chr(0xAA);
}
