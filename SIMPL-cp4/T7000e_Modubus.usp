/*******************************************************************************************
  模块名称: T7000e_Modbus
  功能说明: T7000e温控器Modbus RTU控制模块（精简优化版）
  优化内容:
    1. 删除被注释掉的大段接收处理代码和未使用的注释模板
    2. 精简大块分隔注释，保持核心逻辑注释清晰
    3. 修正Gen_Modbus03中重复发送的注释说明（明确为兼容重发机制）
    4. 启用#SYMBOL_NAME保持风格一致
  支持功能: 开关机、运行模式、风速设定、温度设定
*******************************************************************************************/

#SYMBOL_NAME "T7000e_Modbus"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  常量定义
*******************************************************************************************/
#DEFINE_CONSTANT REG_POWER        49    // 开关机控制寄存器地址
#DEFINE_CONSTANT REG_MODE         50    // 运行模式控制寄存器地址
#DEFINE_CONSTANT REG_SET_TEMP     51    // 温度设定寄存器地址
#DEFINE_CONSTANT REG_FAN_SPEED    52    // 风速设定寄存器地址
#DEFINE_CONSTANT TEMP_MIN         16    // 最低设定温度(℃)
#DEFINE_CONSTANT TEMP_MAX         30    // 最高设定温度(℃)
#DEFINE_CONSTANT TEMP_DEFAULT     24    // 上电默认设定温度(℃)
#DEFINE_CONSTANT CRC_INIT_VALUE   0xFFFF// CRC16初始值（Modbus标准）
#DEFINE_CONSTANT CRC_POLYNOMIAL   0xA001// CRC16-MODBUS多项式

/*******************************************************************************************
  输入输出定义（与原始接口保持一致，确保.ush文件兼容）
*******************************************************************************************/
ANALOG_INPUT	TC_SetTemp;
ANALOG_OUTPUT	TC_SetTemp_Fb;

BUFFER_INPUT	Modbus_RX$[20];

STRING_OUTPUT	Modbus_TX$;

DIGITAL_INPUT	TC_PowerOn,TC_PowerOff;
DIGITAL_INPUT	TC_ModeCool,TC_ModeFan,TC_ModeHeat,TC_ModeAuto;
DIGITAL_INPUT	TC_FanAuto,TC_FanLow,TC_FanMid,TC_FanHigh;

DIGITAL_OUTPUT  TC_PowerOn_Fb,TC_PowerOff_Fb;
DIGITAL_OUTPUT  TC_ModeCool_Fb,TC_ModeFan_Fb,TC_ModeHeat_Fb,TC_ModeAuto_Fb;
DIGITAL_OUTPUT  TC_FanAuto_Fb,TC_FanLow_Fb,TC_FanMid_Fb,TC_FanHigh_Fb;

/*******************************************************************************************
  参数定义
*******************************************************************************************/
INTEGER_PARAMETER SLAVE_ADDR;
INTEGER_PARAMETER BAUD_RATE;

#BEGIN_PARAMETER_PROPERTIES SLAVE_ADDR
	propValidUnits = unitDecimal;
	propBounds = 1d,64d;
	propDefaultUnit = unitDecimal;
	propDefaultValue = 1d;
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES BAUD_RATE
	propValidUnits = unitDecimal;
	propBounds = 0d,1d;
	propDefaultUnit = unitDecimal;
	propDefaultValue = 0d;
#END_PARAMETER_PROPERTIES

/*******************************************************************************************
  全局变量
*******************************************************************************************/
INTEGER DATA[8];
INTEGER CRC_Result;
STRING  CRC_H[1],CRC_L[1];
INTEGER SetTemp_Val;

/*******************************************************************************************
  CRC16-MODBUS校验函数
  参数: data_len - 待校验数据长度
  返回: 16位CRC校验值
*******************************************************************************************/
Integer_FUNCTION CRC16_Modbus(integer data_len)
{
	INTEGER i;
	INTEGER j;
	INTEGER crc;
	crc = CRC_INIT_VALUE;
	for(i = 1 to data_len)
	{
		crc = crc ^ DATA[i];
		for(j = 1 to 8)
		{
			if(crc & 0x01)
			{
				crc = crc >> 1;
				crc = crc ^ CRC_POLYNOMIAL;
			}
			else
			{
				crc = crc >> 1;
			}
		}
	}
	return (crc);
}

/*******************************************************************************************
  Modbus 06功能码指令生成函数（写单个保持寄存器）
  参数: reg_addr - 寄存器地址(十进制)，reg_val - 寄存器写入值(十进制)
*******************************************************************************************/
Function Gen_Modbus06(integer reg_addr, integer reg_val)
{
	DATA[1] = SLAVE_ADDR;
	DATA[2] = 0x06;
	DATA[3] = reg_addr >> 8;
	DATA[4] = reg_addr & 0x00FF;
	DATA[5] = reg_val >> 8;
	DATA[6] = reg_val & 0x00FF;
	CRC_Result = CRC16_Modbus(6);
	CRC_L = CHR(CRC_Result & 0x00FF);
	CRC_H = CHR(CRC_Result >> 8);
	Modbus_TX$ = CHR(DATA[1])+CHR(DATA[2])+CHR(DATA[3])+CHR(DATA[4])+
	CHR(DATA[5])+CHR(DATA[6])+CRC_L+CRC_H;
}

/*******************************************************************************************
  Modbus 03功能码指令生成函数（读保持寄存器）
  参数: reg_addr - 寄存器起始地址(十进制)，reg_num - 读取寄存器数量(十进制)
  说明: 连续发送两次相同指令（200ms间隔），用于提高通讯可靠性
*******************************************************************************************/
Function Gen_Modbus03(integer reg_addr, integer reg_num)
{
	DATA[1] = SLAVE_ADDR;
	DATA[2] = 0x03;
	DATA[3] = reg_addr >> 8;
	DATA[4] = reg_addr & 0x00FF;
	DATA[5] = reg_num >> 8;
	DATA[6] = reg_num & 0x00FF;
	CRC_Result = CRC16_Modbus(6);
	CRC_L = CHR(CRC_Result & 0x00FF);
	CRC_H = CHR(CRC_Result >> 8);
	Modbus_TX$ = CHR(DATA[1])+CHR(DATA[2])+CHR(DATA[3])+CHR(DATA[4])+
	CHR(DATA[5])+CHR(DATA[6])+CRC_L+CRC_H;
	delay(20);
	Modbus_TX$ = CHR(DATA[1])+CHR(DATA[2])+CHR(DATA[3])+CHR(DATA[4])+
	CHR(DATA[5])+CHR(DATA[6])+CRC_L+CRC_H;
}

/*******************************************************************************************
  事件：开关机控制
  寄存器：REG_POWER (49)，0x00=关机，0x01=开机
*******************************************************************************************/
PUSH TC_PowerOn
{
	Gen_Modbus06(REG_POWER, 0x01);
	TC_PowerOn_Fb = 1;
	TC_PowerOff_Fb = 0;
}
PUSH TC_PowerOff
{
	Gen_Modbus06(REG_POWER, 0x00);
	TC_PowerOn_Fb = 0;
	TC_PowerOff_Fb = 1;
}

/*******************************************************************************************
  事件：运行模式控制（互斥逻辑）
  寄存器：REG_MODE (50)
  值定义：0x00=制冷，0x01=通风，0x02=制热，0x03=自动
*******************************************************************************************/
PUSH TC_ModeCool
{
	Gen_Modbus06(REG_MODE, 0x00);
	TC_ModeCool_Fb = 1;
	TC_ModeFan_Fb = 0;
	TC_ModeHeat_Fb = 0;
	TC_ModeAuto_Fb = 0;
}
PUSH TC_ModeFan
{
	Gen_Modbus06(REG_MODE, 0x01);
	TC_ModeCool_Fb = 0;
	TC_ModeFan_Fb = 1;
	TC_ModeHeat_Fb = 0;
	TC_ModeAuto_Fb = 0;
}
PUSH TC_ModeHeat
{
	Gen_Modbus06(REG_MODE, 0x02);
	TC_ModeCool_Fb = 0;
	TC_ModeFan_Fb = 0;
	TC_ModeHeat_Fb = 1;
	TC_ModeAuto_Fb = 0;
}
PUSH TC_ModeAuto
{
	Gen_Modbus06(REG_MODE, 0x03);
	TC_ModeCool_Fb = 0;
	TC_ModeFan_Fb = 0;
	TC_ModeHeat_Fb = 0;
	TC_ModeAuto_Fb = 1;
}

/*******************************************************************************************
  事件：风速控制（互斥逻辑）
  寄存器：REG_FAN_SPEED (52)
  值定义：0x00=自动，0x01=低速，0x02=中速，0x03=高速
*******************************************************************************************/
PUSH TC_FanAuto
{
	Gen_Modbus06(REG_FAN_SPEED, 0x00);
	TC_FanAuto_Fb = 1;
	TC_FanLow_Fb = 0;
	TC_FanMid_Fb = 0;
	TC_FanHigh_Fb = 0;
}
PUSH TC_FanLow
{
	Gen_Modbus06(REG_FAN_SPEED, 0x01);
	TC_FanAuto_Fb = 0;
	TC_FanLow_Fb = 1;
	TC_FanMid_Fb = 0;
	TC_FanHigh_Fb = 0;
}
PUSH TC_FanMid
{
	Gen_Modbus06(REG_FAN_SPEED, 0x02);
	TC_FanAuto_Fb = 0;
	TC_FanLow_Fb = 0;
	TC_FanMid_Fb = 1;
	TC_FanHigh_Fb = 0;
}
PUSH TC_FanHigh
{
	Gen_Modbus06(REG_FAN_SPEED, 0x03);
	TC_FanAuto_Fb = 0;
	TC_FanLow_Fb = 0;
	TC_FanMid_Fb = 0;
	TC_FanHigh_Fb = 1;
}

/*******************************************************************************************
  事件：温度设定控制
  说明: 带50ms防抖和16-30℃边界限制，协议要求温度值×10传输
*******************************************************************************************/
CHANGE TC_SetTemp
{
	CancelAllWait();
	Wait(50, Temp_Set_Debounce)
	{
		if(TC_SetTemp < TEMP_MIN)
		{
			SetTemp_Val = TEMP_MIN * 10;
			TC_SetTemp_Fb = TEMP_MIN;
		}
		else if(TC_SetTemp > TEMP_MAX)
		{
			SetTemp_Val = TEMP_MAX * 10;
			TC_SetTemp_Fb = TEMP_MAX;
		}
		else
		{
			SetTemp_Val = TC_SetTemp * 10;
			TC_SetTemp_Fb = TC_SetTemp;
		}
		Gen_Modbus06(REG_SET_TEMP, SetTemp_Val);
	}
}

/*******************************************************************************************
  事件：串口接收处理
  说明: 当前仅清空接收缓冲区，预留扩展接口
*******************************************************************************************/
CHANGE Modbus_RX$
{
	ClearBuffer(Modbus_RX$);
}

/*******************************************************************************************
  Main函数：系统启动初始化
*******************************************************************************************/
Function Main()
{
	SetTemp_Val = TEMP_DEFAULT * 10;
	CRC_Result = 0;
	Modbus_TX$ = "";
	TC_PowerOff_Fb = 1;
	TC_PowerOn_Fb = 0;
	TC_ModeAuto_Fb = 1;
	TC_FanAuto_Fb = 1;
	TC_SetTemp_Fb = TEMP_DEFAULT;
}
