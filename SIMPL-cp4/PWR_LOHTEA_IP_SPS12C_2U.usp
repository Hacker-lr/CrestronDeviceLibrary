/*******************************************************************************************
  模块名称: PWR_LOHTEA_IP_SPS12C_2U
  功能说明: LOHTEA SPS12C_2U网络电源控制器IP控制模块
  通讯协议: TCP/IP（支持串口透传）
  命令格式: 55 5A 00 11 XX AA
    55 = 帧头
    5A = 固定字节
    00 = 固定字节
    11 = 功能码（电源总控制）
    XX = 控制码（01=全开, 00=全关）
    AA = 帧尾
  支持功能: 电源全开、电源全关
  优化记录: 精简模板代码；提取公共函数；移除重复发送；添加中文注释
*******************************************************************************************/

#SYMBOL_NAME "PWR_LOHTEA_IP_SPS12C_2U"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  输入输出定义（保留原始顺序以兼容 .ush）
*******************************************************************************************/
DIGITAL_INPUT power_allon, power_alloff;
//DIGITAL_INPUT power_on[8], power_off[8];

DIGITAL_OUTPUT power_allon_fb, power_alloff_fb;
//DIGITAL_OUTPUT power_on_fb[8], power_off_fb[8];

BUFFER_INPUT power_rx[100];
STRING_OUTPUT power_tx;

/*******************************************************************************************
  全局变量 - 预定义电源控制命令（初始化时赋值，避免重复计算）
*******************************************************************************************/
STRING cmd_allon[6];
STRING cmd_alloff[6];

/*******************************************************************************************
  辅助函数：设置电源总开关反馈状态（互锁逻辑）
  参数: state - 电源状态（1=开, 0=关）
  说明: 全开和全关反馈互斥，确保UI状态一致
*******************************************************************************************/
Function SetPowerFb(INTEGER state)
{
    power_allon_fb  = state;
    power_alloff_fb = 1 - state;
}

/*******************************************************************************************
  辅助函数：发送串口命令到电源设备
  参数: cmd - 要发送的命令字符串
  说明: 封装发送逻辑，便于统一修改和维护
*******************************************************************************************/
Function SendCmd(STRING cmd)
{
    power_tx = cmd;
}

/*******************************************************************************************
  事件：电源全开
  说明: 按下power_allon后，更新反馈状态并延时1秒发送开机命令
        延时发送是为了避免按钮抖动导致的误操作
        CancelAllWait确保不会与其他命令冲突
*******************************************************************************************/
PUSH power_allon
{
    SetPowerFb(1);
    CancelAllWait();
    WAIT(100)
    {
        SendCmd(cmd_allon);
    }
}

/*******************************************************************************************
  事件：电源全关
  说明: 按下power_alloff后，更新反馈状态并延时1秒发送关机命令
        延时发送是为了避免按钮抖动导致的误操作
        CancelAllWait确保不会与其他命令冲突
*******************************************************************************************/
PUSH power_alloff
{
    SetPowerFb(0);
    CancelAllWait();
    WAIT(100)
    {
        SendCmd(cmd_alloff);
    }
}

/*******************************************************************************************
  Main函数：系统启动时初始化命令字符串
  说明: 将十六进制命令预转换为字符串，避免每次触发时重复拼接
        提高运行效率和代码可读性
*******************************************************************************************/
Function Main()
{
    // 全开命令: 55 5A 00 11 01 AA
    cmd_allon  = chr(0x55) + chr(0x5A) + chr(0x00) + chr(0x11) + chr(0x01) + chr(0xAA);
    // 全关命令: 55 5A 00 11 00 AA
    cmd_alloff = chr(0x55) + chr(0x5A) + chr(0x00) + chr(0x11) + chr(0x00) + chr(0xAA);
}