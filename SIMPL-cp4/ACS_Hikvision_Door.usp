/*******************************************************************************************
  模块名称 : ACS_Hikvision_Door
  功能说明 : 海康威视 ISAPI 远程开门 Crestron SIMPL+ 宏模块
  触发方式 : 脉冲 Open_Door 数字输入 -> 向门禁发送 HTTP PUT 开门指令
  路径容错 : 先尝试小写 /ISAPI/AccessControl/RemoteControl/door/1
             若返回失败(404 / 401 / statusCode!=1) 或超时无响应，
             则自动重试大写路径 .../RemoteControl/Door/1
  接线说明 : http_tx$  ->  TCP/IP Client(IP_ID) 的 String Serial Input
                       IP Address = 192.168.1.110, Port = 80, Protocol = TCP
             TCP/IP Client 的 RX$  ->  http_rx$[1]
  认证说明 : 海康 ISAPI 默认使用 Digest 认证。本模块通过 Auth$ 输入直接
             拼接 "Authorization:" 请求头（调用方自带取值，含末尾不需要换行）：
               - 若设备改用 Basic：填入 "Basic <base64(user:pass)>"
               - 若保持 Digest：需填入一次性的 "Digest ..." 取值，
                 或在 SIMPL Windows 中改用 Crestron 自带 “HTTP Request”
                 符号 / SIMPL# 模块（可自动完成 Digest 握手，我可另行生成）。
  可靠性说明 : 由于 SIMPL+ 无原生 MD5/Base64，故认证头交由外部提供，
             本模块只负责拼装并发送标准 HTTP/1.1 PUT 请求与大小写容错重试。
*******************************************************************************************/
#SYMBOL_NAME "ACS_Hikvision_Door"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  输入输出定义（与 .ush 符号一一对应）
*******************************************************************************************/
DIGITAL_INPUT  Open_Door;          // 脉冲触发开门

STRING_INPUT   Auth$;              // Authorization 头取值（Basic/Digest），留空则不认证
STRING_INPUT   Host$;              // Host 头 / 目标地址，默认 192.168.1.110
STRING_INPUT   Body$;              // 开门指令体，默认 "open"

BUFFER_INPUT   http_rx[256];       // TCP/IP Client 回传的 HTTP 响应

STRING_OUTPUT  http_tx$;           // 发往 TCP/IP Client 的请求字符串
DIGITAL_OUTPUT open_fb;            // 开门指令已发出/成功
DIGITAL_OUTPUT busy;               // 处理中
DIGITAL_OUTPUT err;                // 两次尝试均失败

/*******************************************************************************************
  全局变量
*******************************************************************************************/
STRING GLOBAL CRLF;                // \r\n
STRING GLOBAL HOST;                // 默认主机
STRING GLOBAL PATH_LC;             // 小写路径
STRING GLOBAL PATH_UC;             // 大写路径
STRING GLOBAL REQ_LINE_LC;         // "PUT <小写路径> HTTP/1.1\r\n"
STRING GLOBAL REQ_LINE_UC;         // "PUT <大写路径> HTTP/1.1\r\n"

STRING GLOBAL last_rx;             // 上一次收到的响应（用于检测新数据）
INTEGER GLOBAL pending;            // 0=空闲 1=等待小写响应 2=等待大写响应
LONG_INTEGER GLOBAL sent_ticks;    // 最近一次发送时刻（用于超时判定）

/*******************************************************************************************
  初始化：构造请求行与默认参数
*******************************************************************************************/
FUNCTION Initialize()
{
    CRLF     = CHR(13) + CHR(10);
    HOST     = "192.168.1.110";
    PATH_LC  = "/ISAPI/AccessControl/RemoteControl/door/1";
    PATH_UC  = "/ISAPI/AccessControl/RemoteControl/Door/1";
    REQ_LINE_LC = "PUT " + PATH_LC + " HTTP/1.1" + CRLF;
    REQ_LINE_UC = "PUT " + PATH_UC + " HTTP/1.1" + CRLF;

    pending  = 0;
    open_fb  = 0;
    busy     = 0;
    err      = 0;
    last_rx  = "";
    sent_ticks = 0;
}

/*******************************************************************************************
  判断 HTTP 响应是否为“失败”
  启发式：含 404 / 401，或含 <statusCode> 但取值不为 1，均视为失败
*******************************************************************************************/
FUNCTION IsFail(STRING s) : INTEGER
{
    IF (FIND(s, "404") > 0)        RETURN 1;
    IF (FIND(s, "401") > 0)        RETURN 1;
    IF (FIND(s, "<statusCode>") > 0)
    {
        IF (FIND(s, "<statusCode>1<") == 0)  RETURN 1;
    }
    RETURN 0;
}

/*******************************************************************************************
  拼装并发送 HTTP/1.1 PUT 开门请求
  upper=0 用小写路径，upper=1 用大写路径
*******************************************************************************************/
FUNCTION BuildAndSend(INTEGER upper)
{
    STRING path;
    STRING reqline;
    STRING body;
    STRING host;
    STRING req;

    IF (upper == 1)
    {
        path    = PATH_UC;
        reqline = REQ_LINE_UC;
    }
    ELSE
    {
        path    = PATH_LC;
        reqline = REQ_LINE_LC;
    }

    IF (LENGTH(Body$) > 0)  body = Body$;
    ELSE                    body = "open";

    IF (LENGTH(Host$) > 0)  host = Host$;
    ELSE                    host = HOST;

    req  = reqline;                                   // 请求行 + 换行
    req  = req + "Host: " + host + CRLF;
    IF (LENGTH(Auth$) > 0)
    {
        req = req + "Authorization: " + Auth$ + CRLF;
    }
    req  = req + "Content-Type: application/xml" + CRLF;
    req  = req + "Connection: close" + CRLF;
    req  = req + "Content-Length: " + ITOS(LENGTH(body)) + CRLF;
    req  = req + CRLF;                                // 头结束空行
    req  = req + body;                                // 请求体

    http_tx$ = req;
    sent_ticks = MAKETICKS();
}

/*******************************************************************************************
  轮询响应，处理大小写容错重试与超时
*******************************************************************************************/
FUNCTION Poll()
{
    STRING s;
    LONG_INTEGER dt;

    IF (pending == 0)  RETURN;

    s = http_rx[1];

    // 收到与上一次不同的新响应
    IF (s <> last_rx)
    {
        last_rx = s;
        IF (IsFail(s) == 1)
        {
            IF (pending == 1)
            {
                // 小写失败 -> 试大写
                pending  = 2;
                last_rx  = "";
                BuildAndSend(1);
            }
            ELSE
            {
                err = 1;  busy = 0;  open_fb = 0;  pending = 0;
            }
        }
        ELSE
        {
            // 视为成功
            busy = 0;  open_fb = 1;  pending = 0;
        }
        RETURN;
    }

    // 超时无响应 -> 视为失败并重试/报错
    dt = MAKETICKS() - sent_ticks;
    IF (dt > 2000)
    {
        IF (pending == 1)
        {
            pending  = 2;
            last_rx  = "";
            BuildAndSend(1);
        }
        ELSE
        {
            err = 1;  busy = 0;  open_fb = 0;  pending = 0;
        }
    }
}

/*******************************************************************************************
  主循环：后台轮询（约每 100ms 一次）
*******************************************************************************************/
FUNCTION Main()
{
    WHILE (1)
    {
        Poll();
        WAIT(100) { }
    }
}

/*******************************************************************************************
  事件：脉冲触发开门（先试小写路径）
*******************************************************************************************/
PUSH Open_Door
{
    err     = 0;
    busy    = 1;
    open_fb = 1;
    pending = 1;
    last_rx = "";
    BuildAndSend(0);
}

/*******************************************************************************************
  上电初始化并启动主循环
*******************************************************************************************/
WAIT_FOR_INITIALIZE
{
    Initialize();
    Main();
}
