/*******************************************************************************************
  模块名称: LED_PWR
  功能说明: LED电源控制模块 - 控制LED大屏电源的全开/全关
  通讯协议: ASCII文本协议，以冒号开头，CRLF结尾
  命令格式: :001000B00001000x3X\r\n
    - 全开: :001000B0000100013E\r\n
    - 全关: :001000B0000100023D\r\n
  接口说明: power_tx发送命令, power_rx接收状态反馈
*******************************************************************************************/

#SYMBOL_NAME "LED_PWR"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  输入输出定义
*******************************************************************************************/
DIGITAL_INPUT power_allon,power_alloff;
//DIGITAL_INPUT power_on[8],power_off[8];

DIGITAL_OUTPUT power_allon_fb,power_alloff_fb;
//DIGITAL_OUTPUT power_on_fb[8],power_off_fb[8];

BUFFER_INPUT power_rx[100];
STRING_OUTPUT power_tx;

/*******************************************************************************************
  全局变量 - 预定义电源控制命令
*******************************************************************************************/
STRING cmd_allon, cmd_alloff;

/*******************************************************************************************
  辅助函数：发送串口命令
  参数: cmd - 要发送的命令字符串
*******************************************************************************************/
Function SendCmd(STRING cmd)
{
    CancelAllWait();      // 取消之前的等待，避免命令堆积
    wait(100)             // 等待100ms后发送命令
    {
        power_tx = cmd;   // 发送命令到串口
    }
}

/*******************************************************************************************
  事件：电源全开
  说明: 设置全开反馈状态，发送全开命令
*******************************************************************************************/
PUSH power_allon
{
    power_allon_fb = 1;   // 设置全开反馈为1
    power_alloff_fb = 0;  // 清除全关反馈
    SendCmd(cmd_allon);   // 发送全开命令
}

/*******************************************************************************************
  事件：电源全关
  说明: 设置全关反馈状态，发送全关命令
*******************************************************************************************/
PUSH power_alloff
{
    power_allon_fb = 0;   // 清除全开反馈
    power_alloff_fb = 1;  // 设置全关反馈为1
    SendCmd(cmd_alloff);  // 发送全关命令
}

/*******************************************************************************************
  Main函数：系统启动时初始化命令字符串
  说明: 将十六进制命令预转换为字符串，避免每次触发时重复拼接
*******************************************************************************************/
Function Main()
{
    // 全开命令: :001000B0000100013E\r\n
    cmd_allon = CHR(0x3A) + CHR(0x30) + CHR(0x30) + CHR(0x31) + CHR(0x30) + CHR(0x30) + CHR(0x30) + CHR(0x42) + CHR(0x30) + CHR(0x30) + CHR(0x30) + CHR(0x30) + CHR(0x31) + CHR(0x30) + CHR(0x30) + CHR(0x30) + CHR(0x31) + CHR(0x33) + CHR(0x45) + CHR(0x0D) + CHR(0x0A);
    
    // 全关命令: :001000B0000100023D\r\n
    cmd_alloff = CHR(0x3A) + CHR(0x30) + CHR(0x30) + CHR(0x31) + CHR(0x30) + CHR(0x30) + CHR(0x30) + CHR(0x42) + CHR(0x30) + CHR(0x30) + CHR(0x30) + CHR(0x30) + CHR(0x31) + CHR(0x30) + CHR(0x30) + CHR(0x30) + CHR(0x32) + CHR(0x33) + CHR(0x44) + CHR(0x0D) + CHR(0x0A);
}
