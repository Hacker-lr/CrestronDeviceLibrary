/*******************************************************************************************
  模块名称: PWR_IPS_I208NET
  功能说明: IPS I208NET网络电源控制器控制模块
  通讯协议: RS232/TCP/IP
  串口参数: 波特率9600, 1停止位, 无奇偶校验
  TCP参数: 默认IP 192.168.1.100, 端口8001
  UDP参数: 端口8002
  命令格式: CA 20 FE 19 03 FF XX YY AC
    CA = 帧头
    20 = 固定字节
    FE = 固定字节
    19 = 固定字节
    03 = 长度
    FF = 固定字节
    XX = 控制码（FF=全开, 00=全关）
    YY = 校验码（01=开, 02=关）
    AC = 帧尾
  支持功能: 电源全开、电源全关
*******************************************************************************************/

#SYMBOL_NAME "PWR_IPS_I208NET"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  输入输出定义
*******************************************************************************************/
DIGITAL_INPUT power_allon, power_alloff;
DIGITAL_OUTPUT power_allon_fb, power_alloff_fb;
BUFFER_INPUT power_rx[100];
STRING_OUTPUT power_tx;

/*******************************************************************************************
  辅助函数：发送电源全开命令
  命令: CA 20 FE 19 03 FF FF 01 AC
  说明: 连续发送2次以提高可靠性
*******************************************************************************************/
Function PowerAllOn()
{
    power_tx = chr(0xCA) + chr(0x20) + chr(0xFE) + chr(0x19) + chr(0x03) + chr(0xFF) + chr(0xFF) + chr(0x01) + chr(0xAC);
    power_tx = chr(0xCA) + chr(0x20) + chr(0xFE) + chr(0x19) + chr(0x03) + chr(0xFF) + chr(0xFF) + chr(0x01) + chr(0xAC);
}

/*******************************************************************************************
  辅助函数：发送电源全关命令
  命令: CA 20 FE 19 03 FF 00 02 AC
  说明: 连续发送2次以提高可靠性
*******************************************************************************************/
Function PowerAllOff()
{
    power_tx = chr(0xCA) + chr(0x20) + chr(0xFE) + chr(0x19) + chr(0x03) + chr(0xFF) + chr(0x00) + chr(0x02) + chr(0xAC);
    power_tx = chr(0xCA) + chr(0x20) + chr(0xFE) + chr(0x19) + chr(0x03) + chr(0xFF) + chr(0x00) + chr(0x02) + chr(0xAC);
}

/*******************************************************************************************
  事件：电源全开
  说明: 按下power_allon后，更新反馈状态并延时1秒发送开机命令
        延时发送是为了避免按钮抖动导致的误操作
*******************************************************************************************/
PUSH power_allon
{
    power_allon_fb = 1;
    power_alloff_fb = 0;
    CancelAllWait();
    WAIT(100)
    {
        PowerAllOn();
    }
}

/*******************************************************************************************
  事件：电源全关
  说明: 按下power_alloff后，更新反馈状态并延时1秒发送关机命令
        延时发送是为了避免按钮抖动导致的误操作
*******************************************************************************************/
PUSH power_alloff
{
    power_allon_fb = 0;
    power_alloff_fb = 1;
    CancelAllWait();
    WAIT(100)
    {
        PowerAllOff();
    }
}