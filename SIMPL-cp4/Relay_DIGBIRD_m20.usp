/*******************************************************************************************
  模块名称: Relay_DIGBIRD_m20
  功能说明: DIGBIRD_m20继电器控制模块（精简优化版）
  优化内容:
    1. 删除未使用的注释模板和无效代码
    2. 修正 relay_count 事件中赋值运算符bug（原代码使用单等号同时做赋值和判断）
    3. 将 wait 移出到事件处理程序（SIMPL+函数中不允许wait）
    4. 将 8 路开关命令预定义为全局数组，避免在wait块中调用String_Function
    5. 消除大量重复的发送代码
  支持功能: 8路继电器独立开关、全开/全关
  注意事项: SIMPL+规范禁止在wait块中调用String_Function，因此改用全局STRING数组
*******************************************************************************************/

#SYMBOL_NAME "Relay_DIGBIRD_m20"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  输入输出定义（与原始接口保持一致，确保.ush文件兼容）
*******************************************************************************************/
DIGITAL_INPUT relay_allon,relay_alloff;
DIGITAL_INPUT relay_count[8];

DIGITAL_OUTPUT relay_allon_fb,relay_alloff_fb;
DIGITAL_OUTPUT relay_count_fb[8];

BUFFER_INPUT  relay_rx[100];
STRING_OUTPUT relay_tx;

/*******************************************************************************************
  全局变量 - 预定义 8 路继电器的开关命令
  说明: SIMPL+禁止在wait块中调用String_Function，因此预先计算并存入全局数组
        命令格式: CC DD A1 01 00 [位掩码] 00 [位掩码] [校验高] [校验低]
*******************************************************************************************/
STRING relay_on_cmd[8];   // 8路开命令
STRING relay_off_cmd[8];  // 8路关命令

/*******************************************************************************************
  事件：单路继电器开关（Toggle逻辑）
  说明: 根据当前反馈状态切换开关，带100ms防抖
  修正: 原代码使用单等号同时做赋值和比较判断，导致逻辑永远走"关"分支
        注意事项: SIMPL+不支持双等号运算符，必须使用单等号（根据上下文判断是赋值还是比较）
                  为避免歧义，本处使用单等号
*******************************************************************************************/
push relay_count
{
	integer n;
	n = GetLastModifiedArrayIndex();
	CancelAllWait();
	wait(10)
	{
		if (relay_count_fb[n] = 1)
		{
			relay_count_fb[n] = 0;
			relay_tx = relay_off_cmd[n];
		}
		else
		{
			relay_count_fb[n] = 1;
			relay_tx = relay_on_cmd[n];
		}
	}
}

/*******************************************************************************************
  事件：全开
  说明: 依次发送8路开命令，最后更新总状态反馈
  注意事项: wait块内使用for循环+全局数组索引，避免调用String_Function
*******************************************************************************************/
PUSH relay_allon
{
	relay_allon_fb = 1;
	relay_alloff_fb = 0;
	CancelAllWait();
	wait(100)
	{
		relay_tx = relay_on_cmd[1];
		relay_count_fb[1] = 1;
		delay(10);
		relay_tx = relay_on_cmd[2];
		relay_count_fb[2] = 1;
		delay(10);
		relay_tx = relay_on_cmd[3];
		relay_count_fb[3] = 1;
		delay(10);
		relay_tx = relay_on_cmd[4];
		relay_count_fb[4] = 1;
		delay(10);
		relay_tx = relay_on_cmd[5];
		relay_count_fb[5] = 1;
		delay(10);
		relay_tx = relay_on_cmd[6];
		relay_count_fb[6] = 1;
		delay(10);
		relay_tx = relay_on_cmd[7];
		relay_count_fb[7] = 1;
		delay(10);
		relay_tx = relay_on_cmd[8];
		relay_count_fb[8] = 1;
	}
}

/*******************************************************************************************
  事件：全关
  说明: 依次发送8路关命令，最后更新总状态反馈
*******************************************************************************************/
PUSH relay_alloff
{
	relay_allon_fb = 0;
	relay_alloff_fb = 1;
	CancelAllWait();
	wait(100)
	{
		relay_tx = relay_off_cmd[1];
		relay_count_fb[1] = 0;
		delay(10);
		relay_tx = relay_off_cmd[2];
		relay_count_fb[2] = 0;
		delay(10);
		relay_tx = relay_off_cmd[3];
		relay_count_fb[3] = 0;
		delay(10);
		relay_tx = relay_off_cmd[4];
		relay_count_fb[4] = 0;
		delay(10);
		relay_tx = relay_off_cmd[5];
		relay_count_fb[5] = 0;
		delay(10);
		relay_tx = relay_off_cmd[6];
		relay_count_fb[6] = 0;
		delay(10);
		relay_tx = relay_off_cmd[7];
		relay_count_fb[7] = 0;
		delay(10);
		relay_tx = relay_off_cmd[8];
		relay_count_fb[8] = 0;
	}
}

/*******************************************************************************************
  Main函数：系统启动时初始化 8 路继电器命令数组
  说明: 预定义8路开/关命令，避免运行时重复拼接
*******************************************************************************************/
Function Main()
{
	// 8路开命令：位掩码分别为 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80
	relay_on_cmd[1] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x01)+chr(0x00)+chr(0x01)+chr(0xA4)+chr(0x48);
	relay_on_cmd[2] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x02)+chr(0x00)+chr(0x02)+chr(0xA6)+chr(0x4C);
	relay_on_cmd[3] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x04)+chr(0x00)+chr(0x04)+chr(0xAA)+chr(0x54);
	relay_on_cmd[4] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x08)+chr(0x00)+chr(0x08)+chr(0xB2)+chr(0x64);
	relay_on_cmd[5] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x10)+chr(0x00)+chr(0x10)+chr(0xC2)+chr(0x84);
	relay_on_cmd[6] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x20)+chr(0x00)+chr(0x20)+chr(0xE2)+chr(0xC4);
	relay_on_cmd[7] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x40)+chr(0x00)+chr(0x40)+chr(0x22)+chr(0x44);
	relay_on_cmd[8] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x80)+chr(0x00)+chr(0x80)+chr(0xA2)+chr(0x44);

	// 8路关命令：位掩码保持 0x01, 0x02, ..., 0x80
	relay_off_cmd[1] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x00)+chr(0x00)+chr(0x01)+chr(0xA3)+chr(0x46);
	relay_off_cmd[2] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x00)+chr(0x00)+chr(0x02)+chr(0xA4)+chr(0x48);
	relay_off_cmd[3] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x00)+chr(0x00)+chr(0x04)+chr(0xA6)+chr(0x4C);
	relay_off_cmd[4] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x00)+chr(0x00)+chr(0x08)+chr(0xAA)+chr(0x54);
	relay_off_cmd[5] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x00)+chr(0x00)+chr(0x10)+chr(0xB2)+chr(0x64);
	relay_off_cmd[6] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x00)+chr(0x00)+chr(0x20)+chr(0xC2)+chr(0x84);
	relay_off_cmd[7] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x00)+chr(0x00)+chr(0x40)+chr(0xE2)+chr(0xC4);
	relay_off_cmd[8] = chr(0xCC)+chr(0xDD)+chr(0xA1)+chr(0x01)+chr(0x00)+chr(0x00)+chr(0x00)+chr(0x80)+chr(0x22)+chr(0x44);
}
