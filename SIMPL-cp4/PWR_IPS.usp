/*******************************************************************************************
  模块名称: PWR_IPS
  功能说明: IPS电源控制器控制模块
  通讯协议: RS232
  串口参数: 波特率115200, 1停止位, 无奇偶校验
  命令格式: 55 08 00 00 XX 00 YY AA
    55 = 帧头
    08 = 固定字节
    00 = 固定字节
    00 = 固定字节
    XX = 控制码（80=全开, 81=全关）
    00 = 固定字节
    YY = 校验码（DD=开, DC=关）
    AA = 帧尾
  支持功能: 电源全开、电源全关
*******************************************************************************************/

#SYMBOL_NAME "PWR_IPS"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  输入输出定义
*******************************************************************************************/
DIGITAL_INPUT power_allon, power_alloff;
DIGITAL_OUTPUT power_allon_fb, power_alloff_fb;
BUFFER_INPUT power_rx[100];
STRING_OUTPUT power_tx;

/*******************************************************************************************
  辅助函数：发送电源全开命令
  命令: 55 08 00 00 80 00 DD AA
  说明: 连续发送2次以提高可靠性
*******************************************************************************************/
Function PowerAllOn()
{
    power_tx = chr(0x55) + chr(0x08) + chr(0x00) + chr(0x00) + chr(0x80) + chr(0x00) + chr(0xDD) + chr(0xAA);
    power_tx = chr(0x55) + chr(0x08) + chr(0x00) + chr(0x00) + chr(0x80) + chr(0x00) + chr(0xDD) + chr(0xAA);
}

/*******************************************************************************************
  辅助函数：发送电源全关命令
  命令: 55 08 00 00 81 00 DC AA
  说明: 连续发送2次以提高可靠性
*******************************************************************************************/
Function PowerAllOff()
{
    power_tx = chr(0x55) + chr(0x08) + chr(0x00) + chr(0x00) + chr(0x81) + chr(0x00) + chr(0xDC) + chr(0xAA);
    power_tx = chr(0x55) + chr(0x08) + chr(0x00) + chr(0x00) + chr(0x81) + chr(0x00) + chr(0xDC) + chr(0xAA);
}

/*******************************************************************************************
  事件：电源全开
  说明: 按下power_allon后，更新反馈状态并延时1秒发送开机命令
        延时发送是为了避免按钮抖动导致的误操作
*******************************************************************************************/
PUSH power_allon
{
    power_allon_fb = 1;
    power_alloff_fb = 0;
    CancelAllWait();
    WAIT(100)
    {
        PowerAllOn();
    }
}

/*******************************************************************************************
  事件：电源全关
  说明: 按下power_alloff后，更新反馈状态并延时1秒发送关机命令
        延时发送是为了避免按钮抖动导致的误操作
*******************************************************************************************/
PUSH power_alloff
{
    power_allon_fb = 0;
    power_alloff_fb = 1;
    CancelAllWait();
    WAIT(100)
    {
        PowerAllOff();
    }
}