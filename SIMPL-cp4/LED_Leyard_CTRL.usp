/*******************************************************************************************
  模块名称: LED_Leyard_CTRL
  功能说明: Leyard LED大屏场景控制模块（精简优化版）
  优化内容:
    1. 删除未使用的注释模板和无效代码
    2. 保留场景协议参考注释（供调试查阅）
    3. 精简 switch_scene 函数，消除冗余换行
  支持功能: 4路场景切换控制（通过TCP发送JSON指令）
*******************************************************************************************/

#SYMBOL_NAME "LED_Leyard_CTRL"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  输入输出定义（与原始接口保持一致，确保.ush文件兼容）
*******************************************************************************************/
DIGITAL_INPUT led_scene[4];
DIGITAL_OUTPUT led_scene_fb[4];
BUFFER_INPUT  led_controller_rx[100];
STRING_OUTPUT led_controller_tx;

/*******************************************************************************************
  场景协议参考（JSON格式，通过TCP发送）
  场景1: presetId=0
  场景2: presetId=1
  场景3: presetId=2
  场景4: presetId=3
*******************************************************************************************/

/*******************************************************************************************
  辅助函数：发送场景切换命令
  参数: i - 场景编号(1-4)，对应 presetId=i-1
  协议: JSON格式 [{"cmd":"W0605","deviceId":0,"screenId":0,"presetId":n}]
*******************************************************************************************/
function switch_scene(integer i)
{
	led_controller_tx = "[{" + chr(0x22) + "cmd" + chr(0x22) + ":" + chr(0x22) + "W0605" + chr(0x22) + "," + chr(0x22) + "deviceId" + chr(0x22) + ":0," + chr(0x22) + "screenId" + chr(0x22) + ":0," + chr(0x22) + "presetId" + chr(0x22) + ":" + itoa(i - 1) + "}]";
}

/*******************************************************************************************
  事件：场景按钮按下
  说明: 互斥逻辑，只有当前场景反馈为1，其余为0
*******************************************************************************************/
PUSH led_scene
{
	integer i;
	i = GetLastModifiedArrayIndex();
	SetArray(led_scene_fb, 0);
	led_scene_fb[i] = 1;
	switch_scene(i);
}
