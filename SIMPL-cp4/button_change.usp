/*******************************************************************************************
  模块名称: button_change
  功能说明: 用户可自定义按钮名称模块（精简优化版）
  优化内容:
    1. 删除SIMPL+ IDE自动生成的注释模板和无效代码
    2. 精简 Initialize 和 PUSH 逻辑，移除不必要的局部变量和 THEN/BEGIN/END
    3. 统一注释风格，添加中文功能说明
  支持功能: 10路按钮名称自定义、NVRAM掉电保存
*******************************************************************************************/

#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

// 可修改数量
#DEFINE_CONSTANT MAX_BTNS  10;

// 保存名称用的 NVRAM 键
STRING GLOBAL NV_KEY[MAX_BTNS];

// 默认按钮名
STRING GLOBAL DEFAULT_NAME[MAX_BTNS] = 
{
    "按钮1","按钮2","按钮3","按钮4","按钮5",
    "按钮6","按钮7","按钮8","按钮9","按钮10"
};

// 输入：用户输入新名称 (Input 1~10)
STRING_INPUT USER_INPUT[MAX_BTNS];

// 输出：按钮显示文字 (Output 1~10)
STRING_OUTPUT BTN_TEXT[MAX_BTNS];

/*******************************************************************************************
  初始化函数：加载NVRAM中保存的名称
  说明: 若NVRAM中无数据，则使用默认名称
*******************************************************************************************/
FUNCTION Initialize()
{
    INTEGER i;
    STRING s;

    // 生成NVRAM键
    FOR i = 1 TO MAX_BTNS
    {
        NV_KEY[i] = "BTN_NAME_" + ITOS(i);
    }

    // 读取保存的名称
    FOR i = 1 TO MAX_BTNS
    {
        s = READ_NVRAM(NV_KEY[i]);
        IF (LENGTH(s) > 0)
        {
            BTN_TEXT[i] = s;
        }
        ELSE
        {
            BTN_TEXT[i] = DEFAULT_NAME[i];
        }
    }
}

/*******************************************************************************************
  事件：用户修改输入框文字时触发
  说明: 检测输入变化并更新按钮显示，同时写入NVRAM掉电保存
*******************************************************************************************/
PUSH USER_INPUT_ALL
{
    INTEGER i;

    FOR i = 1 TO MAX_BTNS
    {
        IF (USER_INPUT[i] <> BTN_TEXT[i] AND LENGTH(USER_INPUT[i]) > 0)
        {
            BTN_TEXT[i] = USER_INPUT[i];
            WRITE_NVRAM(NV_KEY[i], USER_INPUT[i]);
        }
    }
}

/*******************************************************************************************
  启动初始化
*******************************************************************************************/
WAIT_FOR_INITIALIZE
{
    Initialize();
}
