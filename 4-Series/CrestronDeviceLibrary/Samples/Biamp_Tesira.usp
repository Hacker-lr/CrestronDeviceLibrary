/*******************************************************************************************
  Biamp Tesira 音频处理器控制 - SIMPL+ 薄壳
  说明：逻辑全在 C# 库 CrestronDeviceLibrary 的 BiampTesiraMatrix 里，本文件只做引脚接线。
  架构与 AudioMatrix_StageCraft 完全一致（C# 直连设备 TCP + 本薄壳接线）。
  协议：Tesira Text Protocol（TTP），纯 ASCII telnet（TCP 23），行尾 CR/LF。
  规则（见 skill）：行尾必须 CRLF；SIMPL+ 无 new（声明即实例化）；类名用简单名。
  实例标签：Tesira 设计文件(.tmf)里每个 DSP 块有唯一 Instance Tag，需在头部配置区填对。
  实时电平：订阅模式。连接登录后 C# 自动 subscribe levels/mutes/meter/交叉点，
            设备变化主动推送（不轮询），静音/路由/电平/Meter 都能实时刷新。
  引脚布局：与 AudioMatrix_StageCraft 相同（数字输入/输出对齐，模拟/串口在 List2 区），
            便于 VTP 直接复用同一套 join。
  库引用：文件名须与 #USER_SIMPLSHARP_LIBRARY 一致（CrestronDeviceLibrary.clz）。
*******************************************************************************************/

#SYMBOL_NAME "Biamp_Tesira"
#DEFINE_CONSTANT CH 16

// =====================================================================
//  [设备连接配置] 改这里，改完重新编译（F12）
//    IP / 端口 / 登录凭据（Tesira 默认 Telnet 23，未保护系统 default/default）
//    各 DSP 块的 Instance Tag（到 Tesira 软件里看块的名字，或 SESSION get aliases 查询）
// =====================================================================
#DEFINE_CONSTANT DEVICE_IP       "192.168.0.24"
#DEFINE_CONSTANT DEVICE_PORT     23
#DEFINE_CONSTANT DEVICE_USERNAME "default"
#DEFINE_CONSTANT DEVICE_PASSWORD "default"
#DEFINE_CONSTANT IN_LEVEL_TAG    "Level1"     // 输入电平/静音块（level/mute 属性）
#DEFINE_CONSTANT OUT_LEVEL_TAG   "Level2"     // 输出电平/静音块
#DEFINE_CONSTANT MIXER_TAG       "Mixer1"     // 矩阵混音块（crosspointLevelState 属性）
#DEFINE_CONSTANT IN_METER_TAG    "AudioMeter1"  // 输入信号表块（Peak/RMS Meter；若输入/输出反了对调这两个）
#DEFINE_CONSTANT OUT_METER_TAG   "AudioMeter2"  // 输出信号表块（"none" = 不轮询音量表）

#DEFAULT_VOLATILE
#ENABLE_TRACE

#USER_SIMPLSHARP_LIBRARY "CrestronDeviceLibrary"

// ===== 变量区（SIMPL+ 规则：所有单个变量/串口缓冲必须在所有数组声明之前） =====
STRING device_ip$[32];
INTEGER _selOutN;            // 当前选中的输出（切回矩阵页时同步给 C#）          // 设备 IP（Main() 里由头部 DEVICE_IP 赋值）
STRING in_level_tag$[50];       // 实例标签（Main() 里由头部常量赋值）
STRING out_level_tag$[50];
STRING mixer_tag$[50];
STRING in_meter_tag$[50];
STRING out_meter_tag$[50];
STRING username$[50];
STRING password$[50];

// 输入变量
DIGITAL_INPUT mode1, mode2, mode3, mode4, mode5, allmute, _skip_;
DIGITAL_INPUT mixpage_fb, mixin_button_fb, mixout_button_fb;
// 输出变量
DIGITAL_OUTPUT mode1fb, mode2fb, mode3fb, mode4fb, mode5fb, allmuteFb, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_;

// ===== 数组区（数字 4 大组在前；Level 组紧跟在 OUTmute / OUTmuteFb 下面，输入输出对称） =====
DIGITAL_INPUT Matrx_IN[CH], _skip_;
DIGITAL_INPUT INmute[CH], _skip_;
DIGITAL_INPUT Matrx_OUT[CH], _skip_;
DIGITAL_INPUT OUTmute[CH], _skip_;
ANALOG_INPUT Level_analogIN[CH], _skip_;
ANALOG_INPUT Level_analogOUT[CH], _skip_;
ANALOG_INPUT _reserved[1];                        // dummy 占位：让 Level_analogOUT 不是 List2 最后一个数组 → 强制展开 CH 行
DIGITAL_INPUT Matrx_IN_audio_jia[CH];
DIGITAL_INPUT Matrx_IN_audio_jian[CH];
DIGITAL_INPUT Matrx_OUT_audio_jia[CH];
DIGITAL_INPUT Matrx_OUT_audio_jian[CH];
DIGITAL_INPUT _reserved2[1];                         // dummy 真数组占位：让 jian 不是最后一个数组 → 强制展开 CH 行（同行 _skip_ 无效，必须真数组，与 List2 的 _reserved[1] 同理）
DIGITAL_OUTPUT MatrxINFb[CH], _skip_;
DIGITAL_OUTPUT INmuteFb[CH], _skip_;
DIGITAL_OUTPUT MatrxOUTFb[CH], _skip_;
DIGITAL_OUTPUT OUTmuteFb[CH], _skip_;
// ---- 对齐占位：数字输出补到与数字输入等长（143），使 List2 起点两侧一致 ----
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_;                                // 与输入尾随 _skip_ 配对（65 个）
ANALOG_OUTPUT Level_analogINFb[CH], _skip_;
ANALOG_OUTPUT level_analogOUTFb[CH], _skip_;
ANALOG_OUTPUT Meter_analogINFb[CH];
ANALOG_OUTPUT Meter_analogOUTFb[CH];
STRING_OUTPUT mix_tx[CH];
STRING_OUTPUT level_tx$[32];  // 必须 = 2*CH；SIMPL+ 数组维度不接受 2*CH 表达式，故用字面量（改 CH 时此处同步改）

// ---------------- 库对象（声明即实例化，不要写 new） ----------------
BiampTesiraMatrix matrix;

// ---------------- 主函数：绑定输出委托 + 配置 + 连接 + 订阅 ----------------
Function Main()
{
    RegisterDelegate(matrix, DigitalFb,  fnDigital);  // 数字反馈 -> _fb 引脚
    RegisterDelegate(matrix, AnalogFb,   fnAnalog);   // 模拟反馈 -> 电平/音量表
    RegisterDelegate(matrix, SerialFb,   fnSerial);   // 串口反馈 -> 显示文本

    // 通道数（值在文件头部 #DEFINE_CONSTANT CH 改）
    matrix.ConfigureChannels(CH);

    // 实例标签（值在文件头部配置区改）
    in_level_tag$  = IN_LEVEL_TAG;
    out_level_tag$ = OUT_LEVEL_TAG;
    mixer_tag$     = MIXER_TAG;
    in_meter_tag$  = IN_METER_TAG;
    out_meter_tag$ = OUT_METER_TAG;
    username$      = DEVICE_USERNAME;
    password$      = DEVICE_PASSWORD;
    matrix.ConfigureTags(in_level_tag$, out_level_tag$, mixer_tag$, in_meter_tag$, out_meter_tag$);
    matrix.ConfigureCredentials(username$, password$);

    device_ip$ = DEVICE_IP;                     // 完整 IP 字符串（值在文件头部配置区改）
    matrix.Configure(device_ip$, DEVICE_PORT);  // IP + 端口（Telnet 默认 23）
    matrix.Start();                             // 直连 + Telnet 协商 + 登录 + 订阅（订阅后设备变化主动推送）
    WaitForInitializationComplete();
}

// ---------------- 静音 ----------------
PUSH INmute  { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.ToggleInputMute(n); }
PUSH OUTmute { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.ToggleOutputMute(n); }
PUSH allmute { matrix.AllMute(1); }

// ---------------- 电平加减 ----------------
PUSH Matrx_IN_audio_jia  { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.InputLevelAdd(n); }
PUSH Matrx_IN_audio_jian { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.InputLevelSub(n); }
PUSH Matrx_OUT_audio_jia { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.OutputLevelAdd(n); }
PUSH Matrx_OUT_audio_jian{ INTEGER n; n = GetLastModifiedArrayIndex(); matrix.OutputLevelSub(n); }

// ---------------- 混音路由 ----------------
PUSH Matrx_OUT
{
    INTEGER n;
    n = GetLastModifiedArrayIndex();
    _selOutN = n;
    matrix.SelectOutput(n);
}
PUSH Matrx_IN  { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.ToggleRoute(n); }

// ---------------- 电平推子（模拟量 -> C# 换算 dB 后发送） ----------------
CHANGE Level_analogIN  { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.SetInputLevelAnalog(n, Level_analogIN[n]); }
CHANGE Level_analogOUT { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.SetOutputLevelAnalog(n, Level_analogOUT[n]); }

// ---------------- 预设 ----------------
PUSH mode1 { matrix.LoadPreset(1);  mode1fb=1; mode2fb=0; mode3fb=0; mode4fb=0; mode5fb=0; }
PUSH mode2 { matrix.LoadPreset(2);  mode1fb=0; mode2fb=1; mode3fb=0; mode4fb=0; mode5fb=0; }
PUSH mode3 { matrix.LoadPreset(3);  mode1fb=0; mode2fb=0; mode3fb=1; mode4fb=0; mode5fb=0; }
PUSH mode4 { matrix.LoadPreset(4);  mode1fb=0; mode2fb=0; mode3fb=0; mode4fb=1; mode5fb=0; }
PUSH mode5 { matrix.LoadPreset(5);  mode1fb=0; mode2fb=0; mode3fb=0; mode4fb=0; mode5fb=1; }

// ---------------- 页面打开时刷新电平/静音 ----------------
CHANGE mixpage_fb
{
    INTEGER n;
    IF(mixpage_fb)
    {
        // SIMPL+ 里 DIGITAL_OUTPUT 不可读，无法扫描 MatrxOUTFb 当前值。
        // 改用 _selOutN 全局变量追踪（PUSH Matrx_OUT 时记录），进入页面同步给 C#。
        IF (_selOutN = 0)
        {
            matrix.SelectOutput(1);
        }
        ELSE
        {
            matrix.SelectOutput(_selOutN);
        }
    }
}

// =====================================================================
//  回调：数字反馈路由（id 见 BiampTesiraMatrix Fb* 常量）
// =====================================================================
CALLBACK FUNCTION fnDigital(INTEGER id, INTEGER v)
{
    IF (id>=1 && id<=CH)
    {
        INmuteFb[id]=v;
    }
    ELSE IF (id>CH && id<=2*CH)
    {
        OUTmuteFb[id-CH]=v;
    }
    ELSE IF (id>2*CH && id<=3*CH)
    {
        MatrxINFb[id-2*CH]=v;
    }
    ELSE IF (id>3*CH && id<=4*CH)
    {
        MatrxOUTFb[id-3*CH]=v;
    }
    ELSE IF (id=4*CH+1)
    {
        mode1fb=v;
    }
    ELSE IF (id=4*CH+2)
    {
        mode2fb=v;
    }
    ELSE IF (id=4*CH+3)
    {
        mode3fb=v;
    }
    ELSE IF (id=4*CH+4)
    {
        mode4fb=v;
    }
    ELSE IF (id=4*CH+5)
    {
        mode5fb=v;
    }
    ELSE IF (id=4*CH+6)
    {
        allmuteFb=v;
    }
}

// =====================================================================
//  回调：模拟反馈路由
// =====================================================================
CALLBACK FUNCTION fnAnalog(INTEGER id, INTEGER v)
{
    IF (id>=1 && id<=CH)
    {
        Level_analogINFb[id]=v;
    }
    ELSE IF (id>CH && id<=2*CH)
    {
        level_analogOUTFb[id-CH]=v;
    }
    ELSE IF (id>2*CH && id<=3*CH)
    {
        Meter_analogINFb[id-2*CH]=v;
    }
    ELSE IF (id>3*CH && id<=4*CH)
    {
        Meter_analogOUTFb[id-3*CH]=v;
    }
}

// =====================================================================
//  回调：串口显示文本路由（1..2*CH -> level_tx$）
// =====================================================================
CALLBACK FUNCTION fnSerial(INTEGER id, STRING text$)
{
    IF (id>=1 && id<=2*CH)
    {
        level_tx$[id]=text$;
    }
}
