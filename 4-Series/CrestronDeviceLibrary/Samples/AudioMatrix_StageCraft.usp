/*******************************************************************************************
  StageCraft  - SIMPL+ 
   C#  CrestronDeviceLibrary  StageCraftMatrix 
   skill CRLFSIMPL+  new
  //
   CHANGE  SetPollMode(1/2/3) SetPollMode(0)
            C#  CTimer  SIMPL+ 
   Detail View ****
            mode1mode1fb, Matrx_IN[i]MatrxINFb[i], INmute[i]INmuteFb[i] 
             _skip_  InputCue/OutputCue 
            //List2 
   #USER_SIMPLSHARP_LIBRARY CrestronDeviceLibrary.clz

#HELP_BEGIN
AudioMatrix_StageCraft controller - StageCraft matrix IP/network driver.

PARAMETERS:
  DeviceIPAddress - IP address of the StageCraft matrix (default 192.168.0.222).
  TcpPort         - TCP port the device listens on (default 1698).

INPUTS:
  mode1..5         - Load preset (13/13/3/4/5).
  allmute          - Mute all.
  Matrx_IN[1..16]  - Toggle input->output crosspoint.
  Matrx_OUT[1..16] - Select current output.
  INmute[1..16]    - Toggle input mute.
  OUTmute[1..16]   - Toggle output mute.

OUTPUTS:
  mode1fb..5fb  - Current mode feedback.
  allmuteFb     - All mute feedback.
  MatrxINFb[1..16] - Input/output crosspoint feedback.
  INmuteFb[1..16]  - Input mute feedback.
  OUTmuteFb[1..16] - Output mute feedback.
#HELP_END

*******************************************************************************************/

#SYMBOL_NAME "AudioMatrix_StageCraft"
#DEFINE_CONSTANT CH 16

#DEFAULT_VOLATILE
#ENABLE_TRACE

#USER_SIMPLSHARP_LIBRARY "CrestronDeviceLibrary"

// =====================================================================
//    SIMPL Windows   Properties/ 
//     .usp/.clz  SIMPL 
//  ------------------------------------------------------------------
//  
//    DeviceIPAddress      IP 
//    TcpPort    TCP 
// =====================================================================
STRING_PARAMETER DeviceIPAddress[32];
INTEGER_PARAMETER TcpPort;
#BEGIN_PARAMETER_PROPERTIES DeviceIPAddress
   propValidUnits = unitString;
   propDefaultUnit = unitString;
   propDefaultValue = "192.168.0.222";
   propShortDescription = "StageCraft matrix IP address";
#END_PARAMETER_PROPERTIES
#BEGIN_PARAMETER_PROPERTIES TcpPort
   propValidUnits = unitDecimal;
   propDefaultUnit = unitDecimal;
   propBounds = 1d, 65535d;
   propDefaultValue = 1698d;
   propShortDescription = "TCP port (default 1698)";
#END_PARAMETER_PROPERTIES

// ===== SIMPL+ / =====
INTEGER _selOutN;            //  C#
// 

DIGITAL_INPUT _skip_, _skip_, mode1, mode2, mode3, mode4, mode5, allmute, _skip_;
DIGITAL_INPUT mixpage_fb, mixin_button_fb, mixout_button_fb;
// 
DIGITAL_OUTPUT _skip_, _skip_, mode1fb, mode2fb, mode3fb, mode4fb, mode5fb, allmuteFb, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_;

// =====  4 Level  OUTmute / OUTmuteFb  =====
DIGITAL_INPUT Matrx_IN[CH], _skip_;
DIGITAL_INPUT INmute[CH], _skip_;
DIGITAL_INPUT Matrx_OUT[CH], _skip_;
DIGITAL_INPUT OUTmute[CH], _skip_;
ANALOG_INPUT Level_analogIN[16], _skip_;         //  OUTmute 
ANALOG_INPUT Level_analogOUT[16], _skip_;        //  Level_analogIN 
ANALOG_INPUT _reserved[1];                        // dummy  Level_analogOUT  List2    16  [#]Alt+ 
DIGITAL_INPUT Matrx_IN_audio_jia[CH];
DIGITAL_INPUT Matrx_IN_audio_jian[CH];
DIGITAL_INPUT Matrx_OUT_audio_jia[CH];
DIGITAL_INPUT Matrx_OUT_audio_jian[CH];
DIGITAL_INPUT _reserved2[1];                        // dummy  jian    16  [#]  15  _skip_ 
DIGITAL_OUTPUT MatrxINFb[CH], _skip_;
DIGITAL_OUTPUT INmuteFb[CH], _skip_;
DIGITAL_OUTPUT MatrxOUTFb[CH], _skip_;
DIGITAL_OUTPUT OUTmuteFb[CH], _skip_;
// ---- 143 List2 Level  Detail View  ----
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_;                                //  _reserved2[1] 65 
ANALOG_OUTPUT Level_analogINFb[16], _skip_;      //  OUTmuteFb 
ANALOG_OUTPUT level_analogOUTFb[16], _skip_;     //  Level_analogINFb 
ANALOG_OUTPUT Meter_analogINFb[16];
ANALOG_OUTPUT Meter_analogOUTFb[16];
STRING_OUTPUT mix_tx[16];
STRING_OUTPUT level_tx$[32];

// ----------------  new ----------------
StageCraftMatrix matrix;

// ----------------  +  +  ----------------
Function Main()
{
    RegisterDelegate(matrix, DigitalFb,  fnDigital);  //  -> _fb 
    RegisterDelegate(matrix, AnalogFb,   fnAnalog);   //  -> /
    RegisterDelegate(matrix, SerialFb,   fnSerial);   //  -> 

    matrix.Configure(DeviceIPAddress, TcpPort);  // IP + SIMPL Windows 
    matrix.Start();                            // 
    //  CHANGE  SetPollMode(1/2/3) SetPollMode(0)
    WaitForInitializationComplete();
}

// ----------------  ----------------
PUSH INmute  { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.ToggleInputMute(n); }
PUSH OUTmute { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.ToggleOutputMute(n); }
PUSH allmute { matrix.AllMute(1); }

// ----------------  ----------------
PUSH Matrx_IN_audio_jia  { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.InputLevelAdd(n); }
PUSH Matrx_IN_audio_jian { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.InputLevelSub(n); }
PUSH Matrx_OUT_audio_jia { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.OutputLevelAdd(n); }
PUSH Matrx_OUT_audio_jian{ INTEGER n; n = GetLastModifiedArrayIndex(); matrix.OutputLevelSub(n); }

// ----------------  ----------------
PUSH Matrx_OUT
{
    INTEGER n;
    n = GetLastModifiedArrayIndex();
    _selOutN = n;
    matrix.SelectOutput(n);
}
PUSH Matrx_IN  { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.ToggleRoute(n); }

// ----------------  -> C#  dB  ----------------
CHANGE Level_analogIN  { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.SetInputLevelAnalog(n, Level_analogIN[n]); }
CHANGE Level_analogOUT { INTEGER n; n = GetLastModifiedArrayIndex(); matrix.SetOutputLevelAnalog(n, Level_analogOUT[n]); }

// ----------------  ----------------
PUSH mode1 { matrix.LoadPreset(13); mode1fb=1; mode2fb=0; mode3fb=0; mode4fb=0; mode5fb=0; }
PUSH mode2 { matrix.LoadPreset(13); mode1fb=0; mode2fb=1; mode3fb=0; mode4fb=0; mode5fb=0; }
PUSH mode3 { matrix.LoadPreset(3);  mode1fb=0; mode2fb=0; mode3fb=1; mode4fb=0; mode5fb=0; }
PUSH mode4 { matrix.LoadPreset(4);  mode1fb=0; mode2fb=0; mode3fb=0; mode4fb=1; mode5fb=0; }
PUSH mode5 { matrix.LoadPreset(5);  mode1fb=0; mode2fb=0; mode3fb=0; mode4fb=0; mode5fb=1; }

// ----------------  ----------------
CHANGE mixpage_fb
{
    INTEGER n;
    INTEGER found;
    found = 0;
    IF(mixpage_fb)
    {
        // "" C#VTP C# 
        //  MatrxOUTFb =1  SelectOutput  C# 
        FOR (n = 1 TO CH)
        {
            IF (found = 0)
            {
                IF (MatrxOUTFb[n])
                {
                    matrix.SelectOutput(n);   // C#  + 
                found = 1;
                }
            }
        }
        //  1
        IF (found = 0)
        {
            matrix.SelectOutput(1);
        }
        matrix.SetPollMode(3);   //  + /meter
    }
    ELSE
    {
        matrix.SetPollMode(0);   // 
    }
}

CHANGE mixout_button_fb
{
    IF(mixout_button_fb)
    {
        matrix.SetPollMode(2);   //  +  meter + 
    }
    ELSE
    {
        matrix.SetPollMode(0);
    }
}

CHANGE mixin_button_fb
{
    IF(mixin_button_fb)
    {
        matrix.SetPollMode(1);   //  +  meter + 
    }
    ELSE
    {
        matrix.SetPollMode(0);
    }
}

// =====================================================================
//  id  StageCraftMatrix Fb* 
//  SIMPL+  IF  { }  C 
// =====================================================================
CALLBACK FUNCTION fnDigital(INTEGER id, INTEGER v)
{
    IF (id>=1 && id<=16)
    {
        INmuteFb[id]=v;
    }
    ELSE IF (id>=17 && id<=32)
    {
        OUTmuteFb[id-16]=v;
    }
    ELSE IF (id>=33 && id<=48)
    {
        MatrxINFb[id-32]=v;
    }
    ELSE IF (id>=49 && id<=64)
    {
        MatrxOUTFb[id-48]=v;
    }
    ELSE IF (id=65)
    {
        mode1fb=v;
    }
    ELSE IF (id=66)
    {
        mode2fb=v;
    }
    ELSE IF (id=67)
    {
        mode3fb=v;
    }
    ELSE IF (id=68)
    {
        mode4fb=v;
    }
    ELSE IF (id=69)
    {
        mode5fb=v;
    }
    ELSE IF (id=70)
    {
        allmuteFb=v;
    }
}

// =====================================================================
//  
// =====================================================================
CALLBACK FUNCTION fnAnalog(INTEGER id, INTEGER v)
{
    IF (id>=1 && id<=16)
    {
        Level_analogINFb[id]=v;
    }
    ELSE IF (id>=17 && id<=32)
    {
        level_analogOUTFb[id-16]=v;
    }
    ELSE IF (id>=33 && id<=48)
    {
        Meter_analogINFb[id-32]=v;
    }
    ELSE IF (id>=49 && id<=64)
    {
        Meter_analogOUTFb[id-48]=v;
    }
}

// =====================================================================
//  1..32 -> level_tx$
// =====================================================================
CALLBACK FUNCTION fnSerial(INTEGER id, STRING text$)
{
    IF (id>=1 && id<=32)
    {
        level_tx$[id]=text$;
    }
}
