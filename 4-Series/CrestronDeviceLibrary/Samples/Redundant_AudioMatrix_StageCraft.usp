/*******************************************************************************************
  StageCraft 16x16 双机热备（一主一备） - SIMPL+ 薄壳
  逻辑在 C# 库 CrestronDeviceLibrary 的 RedundantStageCraftMatrix（RedundantAudioMatrix<StageCraftMatrix>）。
  本文件只做引脚接线 + 主备 IP 配置。

  冗余特性（与单台 AudioMatrix_StageCraft.usp 兼容：控制/反馈引脚布局完全一致）：
    - 主用(Primary) + 备用(Backup) 两台同时连接，所有命令镜像到两端，配置始终一致；
    - 平时控制主用；主用断连立即切到备用（leader 切换，用户无感软切换）；
    - 主用恢复后自动重新同步并切回主用（主用优先）；
    - 反馈只转发当前激活(leader)设备，故 VTP 引脚与单台完全一致；
    - 额外提供（引脚在符号最末尾，不挤占单台版任何 join）：主用在线 primary_online_fb / 备用在线 backup_online_fb + 状态文本 status_tx$[1]（反馈哪台掉线）。

  协议/规则/引脚布局：同 AudioMatrix_StageCraft.usp。
  库引用：#USER_SIMPLSHARP_LIBRARY "CrestronDeviceLibrary"
*******************************************************************************************/

#SYMBOL_NAME "Redundant_AudioMatrix_StageCraft"
#DEFINE_CONSTANT CH 16

// =====================================================================
//  [主用 / 备用设备连接配置] 改这里
// =====================================================================
#DEFINE_CONSTANT PRIMARY_IP    "192.168.0.222"
#DEFINE_CONSTANT BACKUP_IP     "192.168.0.223"
#DEFINE_CONSTANT DEVICE_PORT   1698

#DEFAULT_VOLATILE
#ENABLE_TRACE

#USER_SIMPLSHARP_LIBRARY "CrestronDeviceLibrary"

// ===== 变量区 =====
STRING primary_ip$[32];
STRING backup_ip$[32];
INTEGER _selOutN;            // 当前选中的输出（切回矩阵页时同步给 C#）

// 输入变量
DIGITAL_INPUT mode1, mode2, mode3, mode4, mode5, allmute, _skip_;
DIGITAL_INPUT mixpage_fb, mixin_button_fb, mixout_button_fb;
// 输出变量
DIGITAL_OUTPUT mode1fb, mode2fb, mode3fb, mode4fb, mode5fb, allmuteFb, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_;

// ===== 数组区（与单台 AudioMatrix_StageCraft.usp 完全一致） =====
DIGITAL_INPUT Matrx_IN[CH], _skip_;
DIGITAL_INPUT INmute[CH], _skip_;
DIGITAL_INPUT Matrx_OUT[CH], _skip_;
DIGITAL_INPUT OUTmute[CH], _skip_;
ANALOG_INPUT Level_analogIN[16], _skip_;
ANALOG_INPUT Level_analogOUT[16], _skip_;
ANALOG_INPUT _reserved[1];
DIGITAL_INPUT Matrx_IN_audio_jia[CH];
DIGITAL_INPUT Matrx_IN_audio_jian[CH];
DIGITAL_INPUT Matrx_OUT_audio_jia[CH];
DIGITAL_INPUT Matrx_OUT_audio_jian[CH];
DIGITAL_INPUT _reserved2[1];
DIGITAL_INPUT _skip_, _skip_, _skip_;                // 平衡：冗余数字输出 3 个（primary_online_fb + backup_online_fb + _reserved3 占位），补 3 个数字输入使输入/输出总数相等（引脚对齐）
DIGITAL_OUTPUT MatrxINFb[CH], _skip_;
DIGITAL_OUTPUT INmuteFb[CH], _skip_;
DIGITAL_OUTPUT MatrxOUTFb[CH], _skip_;
DIGITAL_OUTPUT OUTmuteFb[CH], _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_, _skip_;
DIGITAL_OUTPUT _skip_;
ANALOG_OUTPUT Level_analogINFb[16], _skip_;
ANALOG_OUTPUT level_analogOUTFb[16], _skip_;
ANALOG_OUTPUT Meter_analogINFb[16];
ANALOG_OUTPUT Meter_analogOUTFb[16];
STRING_OUTPUT mix_tx[16];
STRING_OUTPUT level_tx$[32];

// ===== 冗余状态反馈引脚（追加在末尾，不挤占单台版任何 join，VTP 可原样复用） =====
// ★ 关键：SIMPL+ 会把"每个方向最后一个数组"折叠成 [#]，折叠后 C# 写该引脚会抛
//   KeyNotFoundException → 模块崩溃 → VTP 显示离线 + 控制失效。
//   修复：把 primary/backup 拆到独立行，并在尾部各加一个真数组占位，让占位成为
//   最后一个被折叠的对象，真正的反馈引脚保留 [1]（.ush 里见 xxx[1] 即成功）。
DIGITAL_OUTPUT primary_online_fb[1];                  // [1]主用在线：1=在线 0=掉线
DIGITAL_OUTPUT backup_online_fb[1];                   // [1]备用在线：1=在线 0=掉线
DIGITAL_OUTPUT _reserved3[1];                         // 真数组占位：防 primary/backup_online_fb 被折叠成 [#]
STRING_OUTPUT  status_tx$[1];                         // [1]=状态文本（人读，如"主用掉线，已切备用"）
STRING_OUTPUT  _reserved4$[1];                        // 真数组占位：防 status_tx$ 被折叠成 [#]

// ---------------- 库对象 ----------------
RedundantStageCraftMatrix rmatrix;

// ---------------- 主函数 ----------------
Function Main()
{
    RegisterDelegate(rmatrix, DigitalFb,       fnDigital);
    RegisterDelegate(rmatrix, AnalogFb,        fnAnalog);
    RegisterDelegate(rmatrix, SerialFb,        fnSerial);
    RegisterDelegate(rmatrix, PrimaryOnlineFb, fnPrimaryOnline);
    RegisterDelegate(rmatrix, BackupOnlineFb,  fnBackupOnline);
    RegisterDelegate(rmatrix, StatusTextFb,    fnStatusText);

    primary_ip$ = PRIMARY_IP;
    backup_ip$  = BACKUP_IP;
    rmatrix.ConfigurePrimary(primary_ip$, DEVICE_PORT);
    rmatrix.ConfigureBackup(backup_ip$, DEVICE_PORT);

    rmatrix.Start();               // 同时连接主备，命令镜像到两端
    // 轮询改为页面驱动：进入对应页面时 CHANGE 事件里调 SetPollMode(1/2/3)，离开调 SetPollMode(0)
    WaitForInitializationComplete();
}

// ---------------- 静音 ----------------
PUSH INmute  { INTEGER n; n = GetLastModifiedArrayIndex(); rmatrix.ToggleInputMute(n); }
PUSH OUTmute { INTEGER n; n = GetLastModifiedArrayIndex(); rmatrix.ToggleOutputMute(n); }
PUSH allmute { rmatrix.AllMute(1); }

// ---------------- 电平加减 ----------------
PUSH Matrx_IN_audio_jia  { INTEGER n; n = GetLastModifiedArrayIndex(); rmatrix.InputLevelAdd(n); }
PUSH Matrx_IN_audio_jian { INTEGER n; n = GetLastModifiedArrayIndex(); rmatrix.InputLevelSub(n); }
PUSH Matrx_OUT_audio_jia { INTEGER n; n = GetLastModifiedArrayIndex(); rmatrix.OutputLevelAdd(n); }
PUSH Matrx_OUT_audio_jian{ INTEGER n; n = GetLastModifiedArrayIndex(); rmatrix.OutputLevelSub(n); }

// ---------------- 混音路由 ----------------
PUSH Matrx_OUT
{
    INTEGER n;
    n = GetLastModifiedArrayIndex();
    _selOutN = n;
    rmatrix.SelectOutput(n);
}
PUSH Matrx_IN  { INTEGER n; n = GetLastModifiedArrayIndex(); rmatrix.ToggleRoute(n); }

// ---------------- 电平推子（模拟量 -> C# 换算 dB 后发送） ----------------
CHANGE Level_analogIN  { INTEGER n; n = GetLastModifiedArrayIndex(); rmatrix.SetInputLevelAnalog(n, Level_analogIN[n]); }
CHANGE Level_analogOUT { INTEGER n; n = GetLastModifiedArrayIndex(); rmatrix.SetOutputLevelAnalog(n, Level_analogOUT[n]); }

// ---------------- 预设 ----------------
PUSH mode1 { rmatrix.LoadPreset(13); mode1fb=1; mode2fb=0; mode3fb=0; mode4fb=0; mode5fb=0; }
PUSH mode2 { rmatrix.LoadPreset(13); mode1fb=0; mode2fb=1; mode3fb=0; mode4fb=0; mode5fb=0; }
PUSH mode3 { rmatrix.LoadPreset(3);  mode1fb=0; mode2fb=0; mode3fb=1; mode4fb=0; mode5fb=0; }
PUSH mode4 { rmatrix.LoadPreset(4);  mode1fb=0; mode2fb=0; mode3fb=0; mode4fb=1; mode5fb=0; }
PUSH mode5 { rmatrix.LoadPreset(5);  mode1fb=0; mode2fb=0; mode3fb=0; mode4fb=0; mode5fb=1; }

// ---------------- 页面驱动轮询（进入页面启动，离开停止） ----------------
CHANGE mixpage_fb
{
    IF(mixpage_fb)
    {
        // ★ SIMPL+ 里 DIGITAL_OUTPUT 不可读，无法扫描 MatrxOUTFb 当前值高亮哪路。
        // 改用 _selOutN 全局变量追踪（PUSH Matrx_OUT 时记录），进入页面同步给 C#。
        IF (_selOutN = 0)
        {
            rmatrix.SelectOutput(1);
        }
        ELSE
        {
            rmatrix.SelectOutput(_selOutN);
        }
        rmatrix.SetPollMode(3);   // 混音页：路由 + 当前输出电平/meter
    }
    ELSE
    {
        rmatrix.SetPollMode(0);   // 离开页面：停止轮询
    }
}

CHANGE mixout_button_fb
{
    IF(mixout_button_fb)
    {
        rmatrix.SetPollMode(2);   // 输出页：输出电平 + 输出 meter + 输出静音
    }
    ELSE
    {
        rmatrix.SetPollMode(0);
    }
}

CHANGE mixin_button_fb
{
    IF(mixin_button_fb)
    {
        rmatrix.SetPollMode(1);   // 输入页：输入电平 + 输入 meter + 输入静音
    }
    ELSE
    {
        rmatrix.SetPollMode(0);
    }
}

// =====================================================================
//  回调：数字反馈路由（id 见 StageCraftMatrix Fb* 常量；仅转发 leader 设备）
// =====================================================================
CALLBACK FUNCTION fnDigital(INTEGER id, INTEGER v)
{
    IF (id>=1 && id<=16)
    {
        INmuteFb[id]=v;
    }
    ELSE IF (id>=17 && id<=32)
    {
        OUTmuteFb[id-16]=v;
    }
    ELSE IF (id>=33 && id<=48)
    {
        MatrxINFb[id-32]=v;
    }
    ELSE IF (id>=49 && id<=64)
    {
        MatrxOUTFb[id-48]=v;
    }
    ELSE IF (id=65)
    {
        mode1fb=v;
    }
    ELSE IF (id=66)
    {
        mode2fb=v;
    }
    ELSE IF (id=67)
    {
        mode3fb=v;
    }
    ELSE IF (id=68)
    {
        mode4fb=v;
    }
    ELSE IF (id=69)
    {
        mode5fb=v;
    }
    ELSE IF (id=70)
    {
        allmuteFb=v;
    }
}

// =====================================================================
//  回调：模拟反馈路由
// =====================================================================
CALLBACK FUNCTION fnAnalog(INTEGER id, INTEGER v)
{
    IF (id>=1 && id<=16)
    {
        Level_analogINFb[id]=v;
    }
    ELSE IF (id>=17 && id<=32)
    {
        level_analogOUTFb[id-16]=v;
    }
    ELSE IF (id>=33 && id<=48)
    {
        Meter_analogINFb[id-32]=v;
    }
    ELSE IF (id>=49 && id<=64)
    {
        Meter_analogOUTFb[id-48]=v;
    }
}

// =====================================================================
//  回调：串口显示文本路由（1..32 -> level_tx$）
// =====================================================================
CALLBACK FUNCTION fnSerial(INTEGER id, STRING text$)
{
    IF (id>=1 && id<=32)
    {
        level_tx$[id]=text$;
    }
}

// =====================================================================
//  回调：冗余状态反馈（新增）
//    PrimaryOnlineFb / BackupOnlineFb：1=在线 0=掉线（直接看出哪台挂了）
//    StatusTextFb：人读状态文本（主备状态一目了然）
// =====================================================================
CALLBACK FUNCTION fnPrimaryOnline(INTEGER id, INTEGER v)
{
    primary_online_fb[1] = v;   // 主用在线：1=在线 0=掉线
}
CALLBACK FUNCTION fnBackupOnline(INTEGER id, INTEGER v)
{
    backup_online_fb[1] = v;   // 备用在线：1=在线 0=掉线
}
CALLBACK FUNCTION fnStatusText(INTEGER id, STRING text$)
{
    status_tx$[1] = text$;
}
